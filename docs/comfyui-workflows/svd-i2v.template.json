{
  "_comment": "Reference API-format workflow for Stable Video Diffusion image-to-video (free open weights, ~8-12 GB VRAM). Load ComfyUI's official SVD image-to-video example, Save (API Format), then align node ids and keep the {placeholders}. StoryForge uploads the reference frame and substitutes its returned filename into {image}; it also fills {prompt} {seed} {frames} {fps} {duration}.",
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "{image}" }
  },
  "11": {
    "class_type": "SVD_img2vid_Conditioning",
    "inputs": {
      "clip_vision": ["12", 0],
      "init_image": ["10", 0],
      "vae": ["13", 0],
      "width": 1024,
      "height": 576,
      "video_frames": "{frames}",
      "motion_bucket_id": 127,
      "fps": "{fps}",
      "augmentation_level": 0.02
    }
  },
  "14": {
    "class_type": "VideoLinearCFGGuidance",
    "inputs": { "model": ["15", 0], "min_cfg": 1.0 }
  },
  "16": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["14", 0],
      "positive": ["11", 0],
      "negative": ["11", 1],
      "latent_image": ["11", 2],
      "seed": "{seed}",
      "steps": 20,
      "cfg": 2.5,
      "sampler_name": "euler",
      "scheduler": "karras",
      "denoise": 1.0
    }
  },
  "17": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["16", 0], "vae": ["13", 0] }
  },
  "18": {
    "class_type": "SaveVideo",
    "inputs": { "images": ["17", 0], "filename_prefix": "storyforge_i2v", "format": "mp4", "fps": "{fps}" }
  }
}
